"""
Mobile Service Master — Admin Launcher
Runs Flask server + opens admin browser
"""
import os
import sys
import time
import threading
import webbrowser

# Setup
ROOT = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, ROOT)
os.chdir(ROOT)

# Create required dirs
for d in ["static/uploads", "data", "database", "logs", "backups"]:
    os.makedirs(os.path.join(ROOT, d), exist_ok=True)


def start_browser(url, delay=2):
    """Open browser after delay"""
    time.sleep(delay)
    try:
        webbrowser.open(url)
    except Exception as e:
        print(f"[BROWSER] {e}")


def main():
    print()
    print("=" * 62)
    print("   Mobile Service Master — ADMIN")
    print("=" * 62)
    print()

    # Import Flask app
    try:
        from web_app import app
    except Exception as e:
        print(f"Failed to import web_app: {e}")
        input("Press Enter to exit...")
        sys.exit(1)

    # Start browser
    url = "http://127.0.0.1:5000/"
    threading.Thread(target=start_browser, args=(url,), daemon=True).start()

    print(f"   Starting server at {url}")
    print(f"   Data dir: {ROOT}")
    print()
    print("   Keep this window open while using the app")
    print("   Close window or Ctrl+C to stop")
    print()
    print("=" * 62)
    print()

    # Run Flask
    port = int(os.environ.get("PORT", 5000))
    app.run(host="127.0.0.1", port=port, debug=False, threaded=True)


if __name__ == "__main__":
    main()
