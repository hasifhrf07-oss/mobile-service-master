}

// ═══════════════════════════════════════════════════════════
// ADMIN PANEL
// ═══════════════════════════════════════════════════════════
async function loadAdminData() {
  // Pending users
  try {
    const res = await fetch('/api/admin/pending-users');
    const d = await res.json();
    const box = document.getElementById('pendingUsers');
    if (d.ok && d.pending && d.pending.length) {
      let h = '<table><tr><th>Email</th><th>Registered</th><th>Action</th></tr>';
      d.pending.forEach(u => {
        h += '<tr>';
        h += '<td>' + u.email + '</td>';
        h += '<td>' + (u.created_at || '').substring(0, 19) + '</td>';
        h += '<td>';
        h += '<button class="rbtn" onclick="approveUser(\'' + u.email + '\')">✅ Approve</button> ';
        h += '<button class="rbtn" onclick="rejectUser(\'' + u.email + '\')">❌ Reject</button>';
        h += '</td></tr>';
      });
      h += '</table>';
      box.innerHTML = h;
    } else {
      box.innerHTML = '<div class="empty"><span class="icon">✅</span><p>কোনো pending user নেই</p></div>';
    }
  } catch (e) {
    document.getElementById('pendingUsers').innerHTML = 'Error: ' + e.message;
  }

  // All users
  try {
    const res = await fetch('/api/admin/all-users');
    const d = await res.json();
    const box = document.getElementById('allUsers');
    if (d.ok && d.users && d.users.length) {
      let h = '<table><tr><th>Email</th><th>Role</th><th>Status</th></tr>';
      d.users.forEach(u => {
        h += '<tr>';
        h += '<td>' + u.email + '</td>';
        h += '<td>' + (u.role || '-') + '</td>';
        h += '<td>' + (u.status || '-') + '</td>';
        h += '</tr>';
      });
      h += '</table>';
      box.innerHTML = h;
    } else {
      box.innerHTML = '<div class="empty"><p>কোনো user নেই</p></div>';
    }
  } catch (e) {}

  // Activity
  try {
    const res = await fetch('/api/admin/activity');
    const d = await res.json();
    const box = document.getElementById('activityLog');
    if (d.ok && d.activity && d.activity.length) {
      let h = '<table><tr><th>Time</th><th>User</th><th>Action</th></tr>';
      d.activity.forEach(a => {
        h += '<tr>';
        h += '<td>' + (a.created_at || '').substring(0, 19) + '</td>';
        h += '<td>' + (a.user_email || '-') + '</td>';
        h += '<td>' + (a.action || '-') + '</td>';
        h += '</tr>';
      });
      h += '</table>';
      box.innerHTML = h;
    } else {
      box.innerHTML = '<div class="empty"><p>কোনো activity নেই</p></div>';
    }
  } catch (e) {}

  // Auto-approve stats
  try {
    const res = await fetch('/api/admin/auto-approve-stats');
    const d = await res.json();
    const box = document.getElementById('autoApproveStats');
    if (d.ok) {
      let h = '<div class="row-info"><span class="lbl">Total Users</span><span class="val">' + (d.total || 0) + '</span></div>';
      h += '<div class="row-info"><span class="lbl">Pending</span><span class="val">' + (d.pending || 0) + '</span></div>';
      h += '<div class="row-info"><span class="lbl">Approved</span><span class="val">' + (d.approved || 0) + '</span></div>';
      h += '<div class="row-info"><span class="lbl">Rejected</span><span class="val">' + (d.rejected || 0) + '</span></div>';
      h += '<div class="row-info"><span class="lbl">Auto-Approve Delay</span><span class="val">' + (d.auto_approve_hours || 24) + ' hours</span></div>';
      box.innerHTML = h;
    }
  } catch (e) {}
}

async function approveUser(email) {
  if (!confirm('Approve ' + email + '?')) return;
  const res = await fetch('/api/admin/approve-user', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({email: email, role: 'technician'})
  });
  const d = await res.json();
  alert(d.message || d.error);
  loadAdminData();
}

async function rejectUser(email) {
  const reason = prompt('Rejection reason (optional):') || '';
  const res = await fetch('/api/admin/reject-user', {
    method: 'POST',
    headers: {'Content-Type': 'application/json'},
    body: JSON.stringify({email: email, reason: reason})
  });
  const d = await res.json();
  alert(d.message || d.error);
  loadAdminData();
}

async function runAutoApproveNow() {
  if (!confirm('Run auto-approve now? This will approve all pending users older than 24 hours.')) return;
  const res = await fetch('/api/admin/auto-approve-now', {method:'POST'});
  const d = await res.json();
  alert('Approved: ' + (d.approved || 0) + ', Pending: ' + (d.pending || 0));
  loadAdminData();
}

