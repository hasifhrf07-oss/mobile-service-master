<!DOCTYPE html>
<html lang="bn">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dashboard — Mobile Service Master</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:"Nirmala UI",Arial,sans-serif;background:linear-gradient(135deg,#1e1e2e,#181825);color:#e0e0e0;min-height:100vh;padding:15px}
.container{max-width:1000px;margin:0 auto;background:#1e1e2e;border-radius:15px;box-shadow:0 10px 40px rgba(0,0,0,.5);overflow:hidden}
.header{background:linear-gradient(135deg,#89b4fa,#cba6f7);padding:18px 22px;color:#1e1e2e;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px}
.header h1{font-size:18px;display:flex;align-items:center;gap:8px}
.user{font-size:12px;text-align:right}
.user .email{font-weight:bold}
.user .role{background:rgba(30,30,46,.3);padding:2px 8px;border-radius:10px;font-size:10px;display:inline-block;margin-top:3px}
.logout{background:rgba(30,30,46,.3);color:#1e1e2e;border:none;padding:6px 14px;border-radius:15px;cursor:pointer;font-size:12px;font-weight:bold;margin-top:5px;font-family:inherit}
.tabs{display:flex;background:#181825;border-bottom:2px solid #313244;overflow-x:auto;scrollbar-width:thin}
.tab{flex:0 0 auto;min-width:95px;padding:14px 12px;text-align:center;cursor:pointer;background:#181825;color:#a6adc8;font-size:12px;font-weight:bold;border:none;font-family:inherit;border-bottom:3px solid transparent}
.tab.active{background:#313244;color:#89b4fa;border-bottom-color:#89b4fa}
.tab:hover:not(.active){background:#252536}
.content{padding:22px;min-height:480px}
.panel{display:none}
.panel.active{display:block}

/* Search Bar */
.search-card{background:linear-gradient(135deg,rgba(137,180,250,.15),rgba(203,166,247,.15));padding:20px;border-radius:12px;margin-bottom:20px;border:1px solid #45475a}
.search-card h3{color:#cba6f7;font-size:14px;margin-bottom:12px;text-transform:uppercase;letter-spacing:1px}
.search-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:12px}
.search-input{flex:1;min-width:180px;background:#11111b;color:#cdd6f4;border:1px solid #45475a;padding:12px 14px;border-radius:8px;font-size:14px;font-family:inherit}
.search-input:focus{outline:none;border-color:#89b4fa}
.search-btn{background:linear-gradient(135deg,#89b4fa,#cba6f7);color:#1e1e2e;border:none;padding:12px 28px;border-radius:8px;font-size:14px;font-weight:bold;cursor:pointer;font-family:inherit}
.search-btn:hover{opacity:.9}
.search-result{background:#181825;padding:14px 18px;border-radius:8px;font-size:14px;line-height:1.7;margin-top:12px;border-left:4px solid #89b4fa;display:none}
.search-result.found{border-left-color:#a6e3a1;background:rgba(166,227,161,.08)}
.search-result.notfound{border-left-color:#f9e2af;background:rgba(249,226,175,.08)}
.search-result.error{border-left-color:#f38ba8;background:rgba(243,139,168,.08)}

/* Stats */
.stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:12px;margin-bottom:20px}
.stat{background:#181825;padding:16px;border-radius:10px;border-left:4px solid #89b4fa}
.stat .num{font-size:26px;font-weight:bold;color:#89b4fa}
.stat .lbl{font-size:11px;color:#a6adc8;margin-top:4px;text-transform:uppercase}

/* Connect */
.connect-area{text-align:center;padding:30px 20px}
.connect-icon{font-size:70px;margin-bottom:15px}
.connect-title{font-size:19px;color:#89b4fa;font-weight:bold;margin-bottom:10px}
.connect-sub{font-size:14px;color:#a6adc8;margin-bottom:25px;line-height:1.6}
.btn{background:linear-gradient(135deg,#89b4fa,#cba6f7);color:#1e1e2e;border:none;padding:14px 40px;border-radius:30px;font-size:16px;font-weight:bold;cursor:pointer;font-family:inherit}
.btn:disabled{opacity:.5;cursor:not-allowed}
.status-area{margin-top:25px;min-height:80px}
.status-msg{background:#181825;border-left:4px solid #89b4fa;padding:14px 18px;border-radius:8px;margin:10px 0;font-size:14px;line-height:1.6}
.status-msg.success{border-left-color:#a6e3a1;background:rgba(166,227,161,.08)}
.status-msg.warning{border-left-color:#f9e2af;background:rgba(249,226,175,.08)}
.status-msg.error{border-left-color:#f38ba8;background:rgba(243,139,168,.08)}

/* Cards */
.card{background:#181825;padding:18px;border-radius:10px;margin-bottom:15px;border-left:4px solid #89b4fa}
.card h3{color:#89b4fa;font-size:13px;margin-bottom:12px;text-transform:uppercase;letter-spacing:1px}
.row-info{display:flex;justify-content:space-between;padding:8px 0;border-bottom:1px solid #313244;font-size:14px}
.row-info:last-child{border-bottom:none}
.row-info .lbl{color:#a6adc8}
.row-info .val{color:#cdd6f4;font-weight:bold}
.prob{display:flex;align-items:center;padding:11px 15px;background:#181825;border-radius:8px;margin:7px 0;border-left:4px solid #313244;font-size:13px}
.prob.ok{border-left-color:#a6e3a1}
.prob.warn{border-left-color:#f9e2af}
.prob.err{border-left-color:#f38ba8}
.prob .pico{font-size:18px;margin-right:10px}
.prob .plbl{flex:1;color:#cdd6f4}
.prob .pval{color:#a6adc8;font-weight:bold}

/* Empty */
.empty{text-align:center;padding:60px 20px;color:#6c7086}
.empty .icon{font-size:55px;display:block;margin-bottom:15px;opacity:.4}
.empty p{font-size:14px;line-height:1.7}
.empty .hint{color:#89b4fa;font-size:12px;margin-top:10px;font-style:italic}

/* Tables */
table{width:100%;border-collapse:collapse;background:#181825;border-radius:10px;overflow:hidden;font-size:13px}
th{background:#252536;color:#89b4fa;padding:11px 9px;text-align:left;font-size:12px;text-transform:uppercase}
td{padding:11px 9px;border-bottom:1px solid #313244;color:#cdd6f4}
tr:hover td{background:#252536}
.badge{display:inline-block;padding:3px 9px;border-radius:12px;font-size:11px;font-weight:bold}
.badge.s{background:rgba(166,227,161,.2);color:#a6e3a1}
.badge.d{background:rgba(243,139,168,.2);color:#f38ba8}
.badge.w{background:rgba(249,226,175,.2);color:#f9e2af}
.badge.i{background:rgba(137,180,250,.2);color:#89b4fa}

/* Decoy panel */
.decoy-icon{font-size:80px;text-align:center;margin:40px 0 20px;opacity:.5}
.decoy-title{text-align:center;font-size:20px;color:#cba6f7;font-weight:bold;margin-bottom:12px}
.decoy-desc{text-align:center;color:#a6adc8;font-size:14px;line-height:1.7;max-width:500px;margin:0 auto 30px}
.decoy-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.decoy-btn{background:#313244;color:#cdd6f4;border:1px solid #45475a;padding:10px 20px;border-radius:8px;cursor:pointer;font-family:inherit;font-size:13px}
.decoy-btn:hover{background:#45475a}
.coming-soon{background:rgba(203,166,247,.1);border:2px dashed #cba6f7;border-radius:12px;padding:20px;text-align:center;margin-top:20px}
.coming-soon h4{color:#cba6f7;font-size:14px;margin-bottom:8px}
.coming-soon p{color:#a6adc8;font-size:12px}

/* Admin section */
.admin-card{background:linear-gradient(135deg,rgba(243,139,168,.15),rgba(249,226,175,.15));border:1px solid #f38ba8}
.admin-card h3{color:#f38ba8}

.hhead{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;flex-wrap:wrap;gap:10px}
.hhead h2{color:#89b4fa;font-size:17px}
.rbtn{background:#313244;color:#89b4fa;border:1px solid #45475a;padding:8px 14px;border-radius:6px;cursor:pointer;font-size:13px;font-family:inherit}

/* Grid for picture */
.picture-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:12px}
.picture-slot label{color:#a6adc8;font-size:12px;display:block;margin-bottom:6px}
.picture-slot input{padding:10px;width:100%}
textarea{resize:vertical;font-family:inherit;width:100%;min-height:70px;margin-top:8px;background:#11111b;color:#cdd6f4;border:1px solid #45475a;padding:12px;border-radius:8px;font-size:14px}
textarea:focus{outline:none;border-color:#89b4fa}

@media(max-width:600px){
  .content{padding:15px}
  .tab{padding:12px 8px;font-size:11px;min-width:80px}
  .search-btn{width:100%}
  .picture-grid{grid-template-columns:1fr}
  table{font-size:11px}
  th,td{padding:8px 6px}
}
</style>
</head>
<body>
<div class="container">

<!-- HEADER -->
<div class="header">
  <h1>🔧 Mobile Service Master</h1>
  <div class="user">
    <div class="email">👤 {{ email }}</div>
    <div class="role">
      {% if is_admin %}👑 Admin{% elif role == "technician" %}🔧 Technician{% else %}⏳ Pending{% endif %}
    </div>
    <div style="opacity:.7;font-size:11px;margin-top:3px">{{ login_time[:19] }}</div>
    <button class="logout" onclick="logout()">Logout</button>
  </div>
</div>

<!-- TABS -->
<div class="tabs" id="tabsBar">
  <button class="tab active" data-tab="connect">📱 Connect</button>
  <button class="tab" data-tab="picture">📸 Picture</button>
  <button class="tab" data-tab="result">📊 Result</button>
  <button class="tab" data-tab="history">📜 History</button>

  <!-- DECOY TABS -->
  <button class="tab" data-tab="calibration">🔬 Calibration</button>
  <button class="tab" data-tab="warranty">🛡️ Warranty</button>
  <button class="tab" data-tab="reports">📄 Reports</button>

  <button class="tab" data-tab="settings">⚙️ Settings</button>
  {% if is_admin %}
  <button class="tab" data-tab="admin" style="background:linear-gradient(135deg,rgba(243,139,168,.3),rgba(249,226,175,.3));color:#f9e2af;">👑 Admin</button>
  {% endif %}
</div>

<div class="content">

<!-- CONNECT TAB -->
<div id="panel-connect" class="panel active">
  <div class="search-card">
    <h3>🔍 Model Search</h3>
    <div class="search-row">
      <input type="text" id="searchBrand" class="search-input" placeholder="Brand (Samsung, Xiaomi...)" onkeydown="if(event.key==='Enter')searchModel()">
      <input type="text" id="searchModel" class="search-input" placeholder="Model (SM-A105F, Redmi 9...)" onkeydown="if(event.key==='Enter')searchModel()">
      <button class="search-btn" onclick="searchModel()">🔍 Search</button>
    </div>
    <div id="searchResult" class="search-result"></div>
  </div>

  <div class="stats">
    <div class="stat"><div class="num" id="totalModels">—</div><div class="lbl">Total Models</div></div>
    <div class="stat"><div class="num" id="totalClones">—</div><div class="lbl">Clone Models</div></div>
  </div>

  <div class="connect-area">
    <div class="connect-icon">📱</div>
    <div class="connect-title">App-এর সাথে connect করুন</div>
    <div class="connect-sub">USB cable দিয়ে ফোন connect করুন<br>তারপর নিচের button-এ click করুন</div>
    <button id="btn" class="btn" onclick="startConnect()">🔌 Connect Now</button>
  </div>
  <div id="status" class="status-area"></div>
</div>

<!-- PICTURE TAB -->
<div id="panel-picture" class="panel">
  <div class="search-card">
    <h3>📸 ৪টি Picture আপলোড করুন</h3>
    <p style="color:#a6adc8;font-size:12px;margin-bottom:14px;">
      Technician-এর meter reading-এর ছবি দিন। অ্যাপ বিশ্লেষণ করবে।
    </p>

    <div class="picture-grid">
      <div class="picture-slot">
        <label>📷 Picture 1</label>
        <input type="file" id="photo_analogue_meter" accept="image/*" class="search-input">
      </div>
      <div class="picture-slot">
        <label>📷 Picture 2</label>
        <input type="file" id="photo_multimeter" accept="image/*" class="search-input">
      </div>
      <div class="picture-slot">
        <label>📷 Picture 3</label>
        <input type="file" id="photo_dc_supply" accept="image/*" class="search-input">
      </div>
      <div class="picture-slot">
        <label>📷 Picture 4 (Optional)</label>
        <input type="file" id="photo_extra" accept="image/*" class="search-input">
      </div>
    </div>

    <button class="search-btn" style="margin-top:16px;width:100%;" onclick="uploadMeterPhotos()">
      🚀 Upload & Analyze
    </button>
  </div>

  <div id="meterStatus" class="status-area"></div>
  <div id="meterResult"></div>

  <div class="card" style="margin-top:20px;">
    <h3>💬 আপনার মতামত দিন</h3>
    <textarea id="commentText" placeholder="কোনো সমস্যা বা পরামর্শ থাকলে লিখুন..."></textarea>
    <button class="search-btn" style="margin-top:10px;width:100%;" onclick="postComment()">
      📩 Comment পাঠান
    </button>
    <div id="commentReply" style="margin-top:12px;"></div>
  </div>

  <div id="meterJobsList" style="margin-top:20px;"></div>
</div>

<!-- RESULT TAB -->
<div id="panel-result" class="panel">
  <div id="result" class="empty">
    <span class="icon">📊</span>
    <p>এখনো কোনো result নেই</p>
    <p class="hint">Connect tab-এ device connect করুন</p>
  </div>
</div>

<!-- HISTORY TAB -->
<div id="panel-history" class="panel">
  <div class="hhead">
    <h2>📜 Service History</h2>
    <button class="rbtn" onclick="loadHistory()">🔄 Refresh</button>
  </div>
  <div id="history">
    <div class="empty"><span class="icon">⏳</span><p>Loading...</p></div>
  </div>
</div>

<!-- CALIBRATION TAB (DECOY) -->
<div id="panel-calibration" class="panel">
  <div class="decoy-icon">🔬</div>
  <div class="decoy-title">Calibration Tools</div>
  <div class="decoy-desc">
    Professional calibration interface for precision instruments.
    Coming soon in the next release.
  </div>
  <div class="decoy-actions">
    <button class="decoy-btn" onclick="showDecoyMsg()">📖 User Manual</button>
    <button class="decoy-btn" onclick="showDecoyMsg()">📅 Schedule Calibration</button>
    <button class="decoy-btn" onclick="showDecoyMsg()">📊 Calibration History</button>
  </div>
  <div class="coming-soon">
    <h4>🚧 Coming Soon</h4>
    <p>This feature is under development</p>
  </div>
</div>

<!-- WARRANTY TAB (DECOY) -->
<div id="panel-warranty" class="panel">
  <div class="decoy-icon">🛡️</div>
  <div class="decoy-title">Warranty Management</div>
  <div class="decoy-desc">
    Track client warranties, service contracts, and expiration reminders.
    Integrated with customer database.
  </div>
  <div class="decoy-actions">
    <button class="decoy-btn" onclick="showDecoyMsg()">➕ Add Warranty</button>
    <button class="decoy-btn" onclick="showDecoyMsg()">🔍 Search Warranty</button>
    <button class="decoy-btn" onclick="showDecoyMsg()">⏰ Expiring Soon</button>
  </div>
  <div class="coming-soon">
    <h4>🚧 Coming Soon</h4>
    <p>This feature is under development</p>
  </div>
</div>

<!-- REPORTS TAB (DECOY) -->
<div id="panel-reports" class="panel">
  <div class="decoy-icon">📄</div>
  <div class="decoy-title">Service Reports</div>
  <div class="decoy-desc">
    Generate professional PDF service reports, invoices, and analytics
    for your clients. Export options available.
  </div>
  <div class="decoy-actions">
    <button class="decoy-btn" onclick="showDecoyMsg()">📊 Monthly Report</button>
    <button class="decoy-btn" onclick="showDecoyMsg()">📈 Analytics</button>
    <button class="decoy-btn" onclick="showDecoyMsg()">💰 Invoice</button>
    <button class="decoy-btn" onclick="showDecoyMsg()">📧 Email Report</button>
  </div>
  <div class="coming-soon">
    <h4>🚧 Coming Soon</h4>
    <p>This feature is under development</p>
  </div>
</div>

<!-- SETTINGS TAB -->
<div id="panel-settings" class="panel">
  <div class="hhead">
    <h2>⚙️ Settings</h2>
    <button class="rbtn" onclick="loadSettings()">🔄 Refresh</button>
  </div>
  <div id="settings">
    <div class="empty"><span class="icon">⏳</span><p>Loading...</p></div>
  </div>
</div>

<!-- ADMIN TAB -->
{% if is_admin %}
<div id="panel-admin" class="panel">
  <div class="hhead">
    <h2>👑 Admin Panel</h2>
    <button class="rbtn" onclick="loadAdminData()">🔄 Refresh</button>
  </div>

  <div class="card admin-card">
    <h3>⏳ Pending Users</h3>
    <div id="pendingUsers">Loading...</div>
  </div>

  <div class="card admin-card">
    <h3>👥 All Users</h3>
    <div id="allUsers">Loading...</div>
  </div>

  <div class="card admin-card">
    <h3>📊 Activity Log</h3>
    <div id="activityLog">Loading...</div>
  </div>

  <div class="card admin-card">
    <h3>🔧 Auto-Approve System</h3>
    <div id="autoApproveStats">Loading...</div>
    <button class="rbtn" style="margin-top:10px;" onclick="runAutoApproveNow()">
      ▶️ Run Auto-Approve Now
    </button>
  </div>
</div>
{% endif %}

</div>
</div>

<script>
// ═══════════════════════════════════════════════════════════
// TAB SWITCHING
// ═══════════════════════════════════════════════════════════
document.querySelectorAll('.tab').forEach(t => t.addEventListener('click', () => {
  document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  t.classList.add('active');
  document.getElementById('panel-' + t.dataset.tab).classList.add('active');

  // Lazy load on tab switch
  const tab = t.dataset.tab;
  if (tab === 'history') loadHistory();
  if (tab === 'settings') loadSettings();
  if (tab === 'picture') loadMeterJobs();
  if (tab === 'admin') loadAdminData();
  if (tab === 'connect') loadDbStats();
}));

function logout() {
  window.location.href = '/logout';
}

// ═══════════════════════════════════════════════════════════
// DECOY MESSAGE
// ═══════════════════════════════════════════════════════════
function showDecoyMsg() {
  alert('🔧 এই ফিচারটি পরবর্তী আপডেটে আসছে।\n\nধন্যবাদ আপনার ধৈর্যের জন্য।');
}

// ═══════════════════════════════════════════════════════════
// MODEL SEARCH
// ═══════════════════════════════════════════════════════════
async function searchModel() {
  const brand = document.getElementById('searchBrand').value.trim();
  const model = document.getElementById('searchModel').value.trim();
  const resultBox = document.getElementById('searchResult');

  if (!brand && !model) {
    resultBox.style.display = 'block';
    resultBox.className = 'search-result error';
    resultBox.innerHTML = '⚠️ Brand or Model likhun';
    return;
  }

  resultBox.style.display = 'block';
  resultBox.className = 'search-result';
  resultBox.innerHTML = '⏳ Searching...';

  try {
    const res = await fetch(`/api/search-model?brand=${encodeURIComponent(brand)}&model=${encodeURIComponent(model)}`);
    const data = await res.json();

    if (data.found) {
      resultBox.className = 'search-result found';
      resultBox.innerHTML = '<b>✅ পাওয়া গেছে!</b><br>' + data.message;
    } else {
      resultBox.className = 'search-result notfound';
      resultBox.innerHTML = '<b>' + data.message + '</b>';
    }
  } catch (e) {
    resultBox.className = 'search-result error';
    resultBox.innerHTML = '❌ Error: ' + e.message;
  }
}

// ═══════════════════════════════════════════════════════════
// DB STATS
// ═══════════════════════════════════════════════════════════
async function loadDbStats() {
  try {
    const res = await fetch('/api/db-stats');
    const d = await res.json();
    if (d.ok) {
      document.getElementById('totalModels').textContent = d.total_models || 0;
      document.getElementById('totalClones').textContent = d.clones || 0;
    }
  } catch (e) {}
}

// ═══════════════════════════════════════════════════════════
// CONNECT FLOW
// ═══════════════════════════════════════════════════════════
function addStatus(type, icon, text) {
  const d = document.createElement('div');
  d.className = 'status-msg ' + type;
  d.innerHTML = '<span style="font-size:18px;margin-right:8px">' + icon + '</span>' + text;
  document.getElementById('status').appendChild(d);
  d.scrollIntoView({behavior:'smooth',block:'end'});
}

let diag = null;

async function startConnect() {
  const btn = document.getElementById('btn');
  btn.disabled = true; btn.textContent = '⏳ Connecting...';
  document.getElementById('status').innerHTML = '';

  try {
    const res = await fetch('/api/connect', {method:'POST', headers:{'Content-Type':'application/json'}});
    const d = await res.json();

    if (!d.ok) {
      let m = 'Connect ব্যর্থ';
      if (d.state === 'unauthorized') m = '⚠️ ফোনে "Allow USB debugging" popup-এ Allow click করুন';
      else if (d.state === 'no_device') m = '❌ USB cable connect করুন এবং Developer Options ON করুন';
      else if (d.message) m = d.message;
      addStatus('error', '❌', m);
      btn.disabled = false; btn.textContent = '🔌 Connect Now';
      return;
    }

    if (d.device) {
      document.getElementById('searchBrand').value = d.device.brand || '';
      document.getElementById('searchModel').value = d.device.model || '';
    }

    addStatus('success', '🎉', '<b>ওয়েলকাম!</b> Device connected.');

    const dr = await fetch('/api/full-diagnose', {method:'POST', headers:{'Content-Type':'application/json'}});
    const dd = await dr.json();

    if (!dd.ok) {
      addStatus('error', '❌', 'Diagnosis ব্যর্থ: ' + (dd.message || 'Unknown'));
      btn.disabled = false; btn.textContent = '🔌 Connect Now';
      return;
    }

    diag = dd;
    addStatus('success', '✅', 'Report ready — Result tab-এ দেখুন।');

    setTimeout(() => {
      document.querySelectorAll('.tab').forEach(x => x.classList.remove('active'));
      document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
      document.querySelector('[data-tab="result"]').classList.add('active');
      document.getElementById('panel-result').classList.add('active');
      renderResult();
    }, 1500);

    btn.disabled = false; btn.textContent = '🔄 Re-Connect';
  } catch (e) {
    addStatus('error', '❌', 'System error: ' + e.message);
    btn.disabled = false; btn.textContent = '🔌 Connect Now';
  }
}

// ═══════════════════════════════════════════════════════════
// RENDER RESULT
// ═══════════════════════════════════════════════════════════
function renderResult() {
  const c = document.getElementById('result');
  if (!diag || !diag.ok) {
    c.className = 'empty';
    c.innerHTML = '<span class="icon">📊</span><p>কোনো result নেই</p>';
    return;
  }

  const d = diag.device || {}, dg = diag.diagnosis || {}, pb = diag.problems || [];
  let h = '<div class="card"><h3>📱 Device Information</h3>';
  h += '<div class="row-info"><span class="lbl">Brand</span><span class="val">' + (d.brand||'-') + '</span></div>';
  h += '<div class="row-info"><span class="lbl">Model</span><span class="val">' + (d.model||'-') + '</span></div>';
  h += '<div class="row-info"><span class="lbl">Chipset</span><span class="val">' + (d.chipset||'-') + '</span></div>';
  h += '<div class="row-info"><span class="lbl">Android</span><span class="val">' + (d.android||'-') + '</span></div>';
  h += '</div>';

  if (pb.length) {
    h += '<h3 style="color:#89b4fa;margin:18px 0 10px;font-size:14px">📋 সমস্যার তালিকা</h3>';
    pb.forEach(p => {
      let ic = '✅', cls = 'ok';
      if (p.status === 'warning') { ic = '⚠️'; cls = 'warn'; }
      if (p.status === 'error') { ic = '❌'; cls = 'err'; }
      h += '<div class="prob ' + cls + '"><span class="pico">' + ic + '</span><span class="plbl">' + p.label + '</span><span class="pval">' + p.value + '</span></div>';
    });
  }

  if (dg.issue_type) {
    h += '<div class="card" style="margin-top:18px;border-left-color:#cba6f7"><h3 style="color:#cba6f7">🔍 Diagnosis</h3>';
    h += '<p style="color:#cdd6f4;line-height:1.7;font-size:14px"><b>Type:</b> ' + dg.issue_type.toUpperCase() + '</p>';
    h += '<p style="color:#cdd6f4;line-height:1.7;font-size:14px;margin-top:6px"><b>Summary:</b> ' + (dg.summary||'-') + '</p>';
    h += '</div>';
  }

  c.className = '';
  c.innerHTML = h;
}

// ═══════════════════════════════════════════════════════════
// PICTURE TAB — Meter Photo Analysis
// ═══════════════════════════════════════════════════════════
async function uploadMeterPhotos() {
  const fd = new FormData();
  const slots = ['analogue_meter', 'multimeter', 'dc_supply', 'extra'];
  let hasFile = false;

  for (const slot of slots) {
    const input = document.getElementById('photo_' + slot);
    if (input && input.files && input.files[0]) {
      fd.append(slot, input.files[0]);
      hasFile = true;
    }
  }

  if (!hasFile) {
    alert('কমপক্ষে একটা Picture দিন');
    return;
  }

  const status = document.getElementById('meterStatus');
  status.innerHTML = '<div class="status-msg">⏳ আপলোড এবং বিশ্লেষণ চলছে...</div>';

  try {
    const res = await fetch('/api/upload-meter-photos', {
      method: 'POST',
      body: fd
    });
    const data = await res.json();

    if (!data.ok) {
      status.innerHTML = '<div class="status-msg error">❌ ' + (data.message || 'সমস্যা') + '</div>';
      return;
    }

    status.innerHTML = '';

    let h = '<div class="card"><h3>🎯 Detect Result</h3>';
    h += '<div class="row-info"><span class="lbl">Brand</span><span class="val">' + (data.brand || 'Unknown') + '</span></div>';
    h += '<div class="row-info"><span class="lbl">Confidence</span><span class="val">' + (data.overall_confidence || 0) + '%</span></div>';
    h += '</div>';

    if (data.diagnosis) {
      h += '<div class="card" style="border-left-color:#cba6f7"><h3 style="color:#cba6f7">🔍 Diagnosis</h3>';
      h += '<p style="color:#cdd6f4;font-size:14px"><b>Verdict:</b> ' + data.diagnosis.verdict + '</p>';
      h += '<p style="color:#cdd6f4;font-size:14px;margin-top:6px">' + (data.diagnosis.summary || '') + '</p>';
      h += '</div>';
    }

    if (data.readings && data.readings.length) {
      h += '<h3 style="color:#89b4fa;margin:18px 0 10px;font-size:14px">📊 Readings</h3>';
      data.readings.forEach(r => {
        let cls = 'ok', ic = '✅';
        if (r.severity === 'CRITICAL') { cls = 'err'; ic = '❌'; }
        else if (r.severity === 'LOW' || r.severity === 'HIGH') { cls = 'warn'; ic = '⚠️'; }
        h += '<div class="prob ' + cls + '">';
        h += '<span class="pico">' + ic + '</span>';
        h += '<span class="plbl">' + (r.rail_label || r.slot || 'Rail') + '</span>';
        h += '<span class="pval">' + r.value + ' ' + (r.unit || 'V') + '</span>';
        h += '</div>';
      });
    }

    document.getElementById('meterResult').innerHTML = h;
    loadMeterJobs();

  } catch (e) {
    status.innerHTML = '<div class="status-msg error">❌ Network error: ' + e.message + '</div>';
  }
}

async function loadMeterJobs() {
  try {
    const res = await fetch('/api/meter-jobs');
    const data = await res.json();
    if (!data.ok || !data.jobs || !data.jobs.length) {
      document.getElementById('meterJobsList').innerHTML =
        '<div class="empty"><span class="icon">📭</span><p>এখনো কোনো job নেই</p></div>';
      return;
    }
    let h = '<h3 style="color:#89b4fa;margin:22px 0 10px;font-size:14px">📜 Recent Jobs</h3>';
    h += '<table><tr><th>Time</th><th>Brand</th><th>Status</th><th>Confidence</th></tr>';
    data.jobs.forEach(j => {
      h += '<tr>';
      h += '<td>' + (j.created_at || '').substring(0, 19) + '</td>';
      h += '<td><b>' + (j.brand || 'Unknown') + '</b></td>';
      h += '<td>' + (j.status || '-') + '</td>';
      h += '<td>' + (j.confidence || 0) + '%</td>';
      h += '</tr>';
    });
    h += '</table>';
    document.getElementById('meterJobsList').innerHTML = h;
  } catch (e) {}
}

async function postComment() {
  const text = document.getElementById('commentText').value.trim();
  if (!text) { alert('Comment likhun'); return; }

  const replyBox = document.getElementById('commentReply');
  replyBox.innerHTML = '<div class="status-msg">⏳ পাঠানো হচ্ছে...</div>';

  try {
    const res = await fetch('/api/comment', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({text: text, job_id: ''})
    });
    const data = await res.json();

    if (!data.ok) {
      replyBox.innerHTML = '<div class="status-msg error">❌ ' + (data.message || 'সমস্যা') + '</div>';
      return;
    }

    replyBox.innerHTML = '<div class="status-msg success">✅ <b>Reply:</b><br>' + data.reply + '</div>';
    document.getElementById('commentText').value = '';
  } catch (e) {
    replyBox.innerHTML = '<div class="status-msg error">❌ ' + e.message + '</div>';
  }
}

// ═══════════════════════════════════════════════════════════
// HISTORY
// ═══════════════════════════════════════════════════════════
async function loadHistory() {
  const c = document.getElementById('history');
  c.innerHTML = '<div class="empty"><span class="icon">⏳</span><p>Loading...</p></div>';
  try {
    const res = await fetch('/api/history-full');
    const d = await res.json();
    if (!d.ok) {
      c.innerHTML = '<div class="empty"><span class="icon">❌</span><p>' + d.message + '</p></div>';
      return;
    }

    let h = '<div class="stats">';
    h += '<div class="stat"><div class="num">' + (d.stats.total_scans||0) + '</div><div class="lbl">Total</div></div>';
    h += '<div class="stat"><div class="num">' + (d.stats.fixed||0) + '</div><div class="lbl">✅ Fixed</div></div>';
    h += '<div class="stat"><div class="num">' + (d.stats.pending||0) + '</div><div class="lbl">⏳ Pending</div></div>';
    h += '</div>';

    const sc = d.scans || [];
    if (!sc.length) {
      h += '<div class="empty"><span class="icon">📭</span><p>কোনো scan নেই</p></div>';
    } else {
      h += '<table><tr><th>Time</th><th>Device</th><th>Status</th></tr>';
      sc.forEach(s => {
        const dev = (s.brand||'?') + ' ' + (s.model||'?');
        const ts = (s.ts||'').substring(0,19);
        h += '<tr><td>' + ts + '</td><td><b>' + dev + '</b></td><td>-</td></tr>';
      });
      h += '</table>';
    }
    c.innerHTML = h;
  } catch (e) {
    c.innerHTML = '<div class="empty"><span class="icon">❌</span><p>' + e.message + '</p></div>';
  }
}

// ═══════════════════════════════════════════════════════════
// SETTINGS
