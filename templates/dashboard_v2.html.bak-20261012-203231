    h += '<div class="row-info"><span class="lbl">Clones</span><span class="val">' + (db.clones||0) + '</span></div>';
    h += '</div>';
    h += '<div class="card" style="border-left-color:#cba6f7"><h3 style="color:#cba6f7">💻 System</h3>';
